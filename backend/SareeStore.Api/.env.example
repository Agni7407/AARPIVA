# ASP.NET Core environment variables (use your host's secret manager)
ConnectionStrings__DefaultConnection=Host=...;Port=5432;Database=...;Username=...;Password=...;SSL Mode=Require;Trust Server Certificate=true
Jwt__Key=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
Jwt__Issuer=SareeStore.Api
Jwt__Audience=SareeStore.Web
Jwt__ExpiryMinutes=120
FrontendUrl=https://yourdomain.com;https://www.yourdomain.com

# Brevo HTTP API
Email__Mode=BrevoApi
Email__FromName=AARPIVA
Email__FromEmail=noreply@yourdomain.com
Brevo__ApiKey=YOUR_BREVO_API_KEY

# Razorpay
Razorpay__KeyId=rzp_live_...
Razorpay__KeySecret=...
Razorpay__ApiBaseUrl=https://api.razorpay.com/v1

# Cloudflare R2 product-image uploads
CloudflareR2__AccessKey=YOUR_R2_ACCESS_KEY_ID
CloudflareR2__SecretKey=YOUR_R2_SECRET_ACCESS_KEY
CloudflareR2__Bucket=aarpiva-products
CloudflareR2__Endpoint=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
CloudflareR2__PublicBaseUrl=https://images.aarpiva.com

# Seed the admin only when intentionally requested. Keep blank in production unless needed.
SeedAdmin__Email=
SeedAdmin__Password=
